# Example secrets file for LukaLibre
# Copy this file to .secrets and fill in your actual values

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
TUNNEL_ID=your-tunnel-id
API_DOMAIN=your-api-domain.com

# Google Service Account Key (base64 encoded)
GCP_SA_KEY=your-base64-encoded-service-account-key

# Database Configuration
DB_PASSWORD=your-secure-database-password

# Terraform Cloud Token
TERRAFORM_TOKEN=your-terraform-cloud-token

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# OpenRouter Configuration (for cost optimization)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=openrouter  # Options: openai, openrouter
FALLBACK_LLM_PROVIDER=openai     # Fallback when primary fails

# Model Configuration - Separate models for cost optimization
TEXT_MODEL=qwen/qwen3-coder:free          # Model for text-only tasks (free, specialized for code)
IMAGE_MODEL=google/gemini-2.5-flash      # Model for image processing (vision capable, fast)
FALLBACK_TEXT_MODEL=gpt-4o-mini          # Fallback text model
FALLBACK_IMAGE_MODEL=gpt-4o-mini         # Fallback image model

# Alternative cost-optimized models (examples)
# TEXT_MODEL=anthropic/claude-3-haiku     # Very cheap for text
# TEXT_MODEL=meta-llama/llama-3.1-8b      # Open source alternative
# IMAGE_MODEL=openai/gpt-4o-mini          # Vision-capable
# IMAGE_MODEL=anthropic/claude-3-sonnet   # Alternative vision model

# Frontend Environment Variables (copy these to frontend/.env)
# VITE_TEXT_MODEL=qwen/qwen3-coder:free
# VITE_IMAGE_MODEL=google/gemini-2.5-flash
# VITE_FALLBACK_TEXT_MODEL=gpt-4o-mini
# VITE_FALLBACK_IMAGE_MODEL=gpt-4o-mini
# VITE_DEFAULT_LLM_PROVIDER=openrouter
# VITE_OPENROUTER_API_KEY=your-openrouter-api-key
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cost Optimization Settings
ENABLE_COST_OPTIMIZATION=true
MAX_MONTHLY_LLM_COST=50          # USD limit per month
COST_ALERT_THRESHOLD=0.8         # Alert when 80% of limit reached